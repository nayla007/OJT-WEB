generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model kategori_pelatihan {
  id_kategori   Int              @id @default(autoincrement())
  nama_kategori String
  data          data_pelatihan[]
}

model data_pelatihan {
  id_pelatihan        Int                @id @default(autoincrement())
  nama_pelatihan      String?
  tujuan              String
  persyaratan         String
  materi_pembelajaran String
  instruktur          String
  sertifikasi         String
  metode_pembelajaran String
  biaya               String
  fasilitas           String
  contact             String
  id_kategori         Int
  file_url            String?
  kategori            kategori_pelatihan @relation(fields: [id_kategori], references: [id_kategori])

  // tambahan
  jadwal    jadwal[]
  pendaftar datapendaftar[]

  @@index([id_kategori], map: "data_pelatihan_id_kategori_fkey")
}

model admin {
  id       Int     @id @default(autoincrement())
  username String  @unique(map: "Admin_username_key")
  password String
  role     String  @default("admin")
  akses    Boolean @default(false)
}

model datapendaftar {
  id           Int    @id @default(autoincrement())
  institusi    String
  alamat       String
  telepon      String
  fax          String
  email        String
  namaPeserta  String
  telPeserta   String
  emailPeserta String

  //tambahan
  id_pelatihan Int
  pelatihanRef data_pelatihan @relation(fields: [id_pelatihan], references: [id_pelatihan], onDelete: Cascade)

  buktiBayar String?
  status     String  @default("MENUNGGU_BAYAR")

  peserta DataPeserta?
}

c

// tambahan
model DataPeserta {
  id                 Int      @id @default(autoincrement())
  id_data_pendaftar  Int      @unique
  tanggal_konfirmasi DateTime @default(now())

  // Tambahan untuk sertifikat
  nomorSertifikat String? @unique
  fileSertifikat  String?

  pendaftar datapendaftar @relation(fields: [id_data_pendaftar], references: [id], onDelete: Cascade)
}
