generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model kategori_pelatihan {
  id_kategori   Int              @id @default(autoincrement())
  nama_kategori String
  data          data_pelatihan[]
}

model data_pelatihan {
  id_pelatihan        Int                @id @default(autoincrement())
  nama_pelatihan      String?
  tujuan              String
  persyaratan         String
  materi_pembelajaran String
  instruktur          String
  sertifikasi         String
  metode_pembelajaran String
  biaya               String
  fasilitas           String
  contact             String
  id_kategori         Int
  file_url            String?
  kategori            kategori_pelatihan @relation(fields: [id_kategori], references: [id_kategori])

  @@index([id_kategori], map: "data_pelatihan_id_kategori_fkey")
}

model admin {
  id       Int     @id @default(autoincrement())
  username String  @unique(map: "Admin_username_key")
  password String
  role     String  @default("admin")
  akses    Boolean @default(false)
}

model datapendaftar {
  id           Int    @id @default(autoincrement())
  institusi    String
  alamat       String
  telepon      String
  fax          String
  email        String
  namaPeserta  String
  telPeserta   String
  emailPeserta String
  pelatihan    String
}

model jadwal {
  id      Int     @id @default(autoincrement())
  bidang  String
  nama    String
  harga   Int
  jmlHari Int
  bulan   String?
  tanggal String?
}
